# Backend environment example (DO NOT commit real secrets)
NODE_ENV=development
PORT=3001

# Frontend URL used to build exam links
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# SMTP example (SendGrid recommended for production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<SENDGRID_API_KEY>
EMAIL_FROM="ExamTrust <no-reply@yourdomain.com>"
MAILER_ALLOW_SELF_SIGNED=false

# IP retention: number of days to keep IP/proctoring data before pseudonymize/delete
IP_RETENTION_DAYS=90

# Purge behavior
# PSEUDONYMIZE=true  -> replace IPs with one-way hash (recommended)
# PSEUDONYMIZE_SALT=<secret stored in secret manager>
# DRY_RUN=true -> script will only report counts but not modify data

DATABASE_URL="mysql://root@127.0.0.1:3306/examtrust"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Webcam evidence files must be stored on an encrypted persistent volume in production.
# The API never writes webcam image bytes to MySQL.
PROCTORING_EVIDENCE_DIR=./var/proctoring-evidence

# Vision provider used asynchronously by the ai-generation worker.
# Use `mock` to keep evidence capture/review without AI tags.
# Use `ollama` to run vision locally (recommended for sensitive webcam images).
# Other valid values: google | nvidia | openrouter | deepseek
AI_PROVIDER=ollama
GOOGLE_AI_API_KEY=

# Only needed when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Only needed when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat

# Self-hosted Ollama. Install/pull the model on the worker host, for example:
#   ollama pull moondream
# Image bytes are sent only to this URL; keep it on the private application network.
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_MODEL=gemma3:4b
AI_OLLAMA_VISION_MODEL=moondream
# Backward-compatible aliases if your deployment already uses OLLAMA_* names.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=moondream

JWT_SECRET="examtrust-secret-key-2024-very-secure-key"
JWT_EXPIRES_IN="360d"
